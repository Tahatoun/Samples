public abstract class ScheduledBackgroundService : BackgroundService
{
    protected abstract TimeSpan TimerDelay { get; }
    protected abstract TimeSpan TimerPeriod { get; }

    protected abstract Task DoWorkAsync(CancellationToken cancellationToken);

    private readonly ILogger<ScheduledBackgroundService> _logger;

    protected ScheduledBackgroundService(
        ILogger<ScheduledBackgroundService> logger)
    {
        _logger = logger;
    }

    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
    {
        var serviceName = GetType().Name;

        _logger.LogInformation(
            "Background service {ServiceName} has been scheduled. Initial delay: {TimerDelay}. Execution period: {TimerPeriod}.",
            serviceName,
            TimerDelay,
            TimerPeriod);

        await Task.Delay(TimerDelay, stoppingToken);

        _logger.LogInformation(
            "Background service {ServiceName} has been awakened after the initial delay and will now execute every {TimerPeriod}.",
            serviceName,
            TimerPeriod);

        using var timer = new PeriodicTimer(TimerPeriod);

        while (await timer.WaitForNextTickAsync(stoppingToken))
        {
            try
            {
                _logger.LogInformation(
                    "Execution window reached for background service {ServiceName}. Starting scheduled task execution.",
                    serviceName);

                await DoWorkAsync(stoppingToken);

                _logger.LogInformation(
                    "Scheduled task execution completed successfully for background service {ServiceName}.",
                    serviceName);
            }
            catch (OperationCanceledException) when (stoppingToken.IsCancellationRequested)
            {
                _logger.LogInformation(
                    "Background service {ServiceName} execution was cancelled because the application is shutting down.",
                    serviceName);

                break;
            }
            catch (Exception ex)
            {
                _logger.LogError(
                    ex,
                    "An error occurred while executing scheduled task for background service {ServiceName}.",
                    serviceName);
            }
        }

        _logger.LogInformation(
            "Background service {ServiceName} has stopped.",
            serviceName);
    }
}